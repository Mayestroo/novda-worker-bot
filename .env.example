# Novda Ishchilar Boti — Muhit O'zgaruvchilari Namunalari
# Ushbu faylni .env qilib nusxalab, tokeningizni yozing.

# Telegram @BotFather dan olingan bot tokeni
WORKER_BOT_TOKEN=8900843680:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Asosiy korxona ID si (standart: comp_novda)
DEFAULT_COMPANY_ID=comp_novda

# Port (Render da avtomatik 10000 bo'ladi, lokalda 8081)
PORT=10000

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://hisobchi-c930c-default-rtdb.asia-southeast1.firebasedatabase.app

# WebApp URL (Ixtiyoriy: agar o'zining ichki serveridan boshqa manzil ishlatmoqchi bo'lsangiz)
# WORKER_WEBAPP_URL=https://hisobmonitoringbot.onrender.com/worker-app
